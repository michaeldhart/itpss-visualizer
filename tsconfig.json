{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2021", "DOM", "DOM.Iterable"],
        "strict": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "types": ["vite/client"]
    },
    "include": ["src", "site"]
}
